{
  "rewrites": [
    {
      "source": "/((?!api/|src/|@vite/|@react-refresh|node_modules/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/meeting/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
